# ── Deployer ───────────────────────────────────────────────────────────────
# Private key of the wallet funding the deploy (never commit this)
PRIVATE_KEY=0x...

# ── Network ────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# or Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Etherscan verification ─────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Deploy options (optional) ──────────────────────────────────────────────
# Override token owner (defaults to deployer if unset)
# INITIAL_OWNER=0x...

# Seed this address with 1M mUSDC after deploy (e.g. your VelaVault address)
# SEED_ADDRESS=0x...

# ── Frontend (populated after deploy) ─────────────────────────────────────
NEXT_PUBLIC_TEST_TOKEN_ADDRESS=0x...
