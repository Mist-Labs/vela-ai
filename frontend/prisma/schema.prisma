generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AgentSession {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  currentStep   Int      @default(1)

  policyRoot    String?
  policyURI     String?
  lastDecision  Json?
  lastTxHash    String?
  lastError     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}